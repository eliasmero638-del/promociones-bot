# Cadena de conexión a PostgreSQL (Neon)
DATABASE_URL=postgresql://usuario:password@host/dbname?sslmode=require

# Zona horaria usada para calcular "hoy", "semana" y "mes" (nombre de zona IANA)
TIMEZONE=America/Guayaquil

# Carpeta donde Baileys guarda la sesión vinculada de WhatsApp
AUTH_DIR=./auth_info

# Opcional: si se define, el bot solo responde a este número (solo dígitos,
# con código de país, sin "+"). Ej: 593999999999
ALLOWED_SENDER=
