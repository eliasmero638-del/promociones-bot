 "segmentos": [
  {
   "texto": "Millones le rezan… a un esqueleto vestido como virgen.",
   "t0": 0.0,
   "img": "esc_00.jpg",
   "escena": {
    "tipo": "foto",
    "img": 3
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Es la Santa Muerte, nacida en México.",
   "t0": 5.197,
   "img": "esc_01.jpg",
   "escena": {
    "tipo": "foto",
    "img": 7
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Lleva túnica, guadaña y un globo en la mano.",
   "t0": 8.87,
   "img": "esc_02.jpg",
   "escena": {
    "tipo": "foto",
    "img": 1
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Por décadas se le rezó en secreto, dentro de las casas.",
   "t0": 12.93,
   "img": "esc_03.jpg",
   "escena": {
    "tipo": "foto",
    "img": 4
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "En dos mil uno, Enriqueta Romero abrió su santuario en la Ciudad de México.",
   "t0": 17.77,
   "img": "esc_04.jpg",
   "escena": {
    "tipo": "video",
    "url": "https://m.youtube.com/watch?v=AwqbbrZG55c",
    "desde": 30,
    "dur": 6,
    "img": 8
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "El gobierno le canceló el registro religioso, y la Iglesia la condena.",
   "t0": 23.75,
   "img": "esc_05.jpg",
   "escena": {
    "tipo": "foto",
    "img": 12
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Pero hoy se calcula que tiene doce millones de seguidores.",
   "t0": 28.52,
