   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "En los días siguientes caen eBay, Amazon, CNN y otras más.",
   "t0": 10.98,
   "img": "esc_02.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
