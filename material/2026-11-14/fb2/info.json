     "Amazon.com 2000"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "El FBI buscaba a una banda de expertos.",
   "t0": 17.34,
   "img": "esc_03.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
