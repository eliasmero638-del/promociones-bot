 en YouTube: http://bit.ly/2Jhc3oO.\r\n\r\nDescargue nuestra aplicación: http://hyperurl.co/appnoticias\r\nSíganos en Google: http://bit.ly/2MrIZP3\r\nWhatsApp El Periodista Soy Yo: http://bit.ly/2QD18rw\r\nWhatsApp Noticias Caracol Ahora: http://bit.ly/34ed1uQ\r\n\r\nSíganos en redes sociales:\r\n\r\nFacebook:   / noticiascaracol  \r\nTwitter:   / noticiascaracol   (@NoticiasCaracol)\r\nInstagram:   / noticiascaracol  \r\n\r\nNuestros canales en YouTube:\r\n\r\nCaracol Televisión: http://bit.ly/2CHpld2 Suscribirse\r\nGol Caracol: http://bit.ly/2yAIGcU Suscribirse\r\nVolk: https://bit.ly/3nNojU9 Suscribirse\r\nShock: http://bit.ly/2CHNKzi Suscribirse\r\nBlu Radio: http://bit.ly/2CFF7Fo Suscribirse\r\nLa Kalle: http://bit.ly/2JkgfEz Suscribirse\r\nCaracol Play: http://bit.ly/2SkyjlM Suscribirse\r\nEl Espectador: http://bit.ly/2D4rkt7 Suscribirse","commandRuns":[{"startIndex":211,"length":16,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCYQ3NcEGC0iEwi73-HxsKqYAxWGxxEIHUiXGVfKAQT8dg6A","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/noticiascaracol","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUTCg9ub3RpY2lhc2NhcmFjb2wYAQ%3D%3D"}}},"loggingDirectives":{"trackingParams":"CCYQ3NcEGC0iEwi73-HxsKqYAxWGxxEIHUiXGVc="}},{"startIndex":228,"length":17,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCUQ3NcEGC4iEwi73-HxsKqYAxWGxxEIHUiXGVfKAQT8dg6A","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/noticiascolombia","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gUUChBub3RpY2lhc2NvbG9tYmlhGAE%3D"}}},"loggingDirectives":{"trackingParams":"CCUQ3NcEGC4iEwi73-HxsKqYAxWGxxEIHUiXGVc="}},{"startIndex":246,"length":24,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCQQ3NcEGC8iEwi73-HxsKqYAxWGxxEIHUiXGVfKAQT8dg6A","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/noticiasi