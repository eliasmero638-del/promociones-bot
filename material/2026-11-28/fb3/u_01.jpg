},"browseEndpoint":{"browseId":"UCdjLpzggOvJyIYdyvad6RPw","canonicalBaseUrl":"/@hotnewsnow2631"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_kZgWbOgFo8RdgE6J7ZNtStuVZHkG2G-fYemoFUJjN8cQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Mehr anzeigen"}},"simpleText":"...mehr"},"showLessText":{"simpleText":"Weniger anzeigen"},"attributedDescriptionBodyText":{"content":"A rocket-powered aircraft designed for space tourists broke apart and crashed during a test flight in California’s Mojave Desert on Friday, killing one pilot and injuring the other.\n\nVirgin Galactic LLC’s SpaceShipTwo was on its first powered flight using a new fuel mixture for a redesigned engine system. If the first few test flights went well, it was supposed to take its inaugural passenger, company founder Richard Branson , out of the atmosphere in the next few months. Ahead of Friday’s test, company officials expected commercial service would begin as soon as early next year.\n\nA rocket-powered aircraft designed for space tourists broke apart and crashed during a test flight in California’s Mojave Desert on Friday, killing one pilot and injuring the other.\n\nVirgin Galactic LLC’s SpaceShipTwo was on its first powered flight using a new fuel mixture for a redesigned engine system. If the first few test flights went well, it was supposed to take its inaugural passenger, company founder Richard Branson , out of the atmosphere in the next few months. Ahead of Friday’s test, company officials expected commercial service would begin as soon as early next year.\n\nRegardless of what emerges as the cause of the disaster, which the company called a “serious anomaly,” the event is a setback for the budding space-tourism industry. It could even prompt federal efforts to step up oversight of such ventures.\n\n\nvirgin galactic,\nvirgin galactic spaceship 2,\nvirgin galactic crash,\nvirgin galactic space flight,\nvirgin galactic 2014,\nvirgin galactic documentary,\nvirgin galactic commercial,\nvirgin galactic test flight 2014,\nvirgin galactic test flight,\nvirgin galactic landing,\nvirgin galactic spaceship 2,\nvirgin galactic crash,\nvirgin galactic space flight,\nvirgin galactic test flight 2014,\nvirgin galactic test flight,\nvirgin galactic crash,\nvirgin galactic spaceship 2 test flight,\nspaceship 2 virgin galactic,","styleRuns":[{"startIndex":0,"length":1923,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":1923,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"colorSampledDescriptionBodyText":{"content":"A rocket-powered aircraft designed for space tourists broke apart and crashed during a test flight in California’s Mojave Desert on Friday, killing one pilot and injuring the other.\n\nVirgin Galactic LLC’s SpaceShipTwo was on its first powered flight using a new fuel mixture for a redesigned engine system. If the first few test flights went well, it was supposed to take its inaugural passenger, company founder Richard Branson , out of the atmosphere in the next few months. Ahead of Friday’s test, company officials expected commercial service would begin as soon as early next year.\n\nA rocket-powered aircraft designed for space tourists broke apart and crashed during a test flight in California’s Mojave Desert on Friday, killing one pilot and injuring the other.\n\nVirgin Galactic LLC’s SpaceShipTwo was on its first powered flight using a new fuel mixture for a redesigned engine system. If the first few test flights went well, it was supposed to take its inaugural passenger, company founder Richard Branson , out of the atmosphere in the next few months. Ahead of Friday’s test, company officials expected commercial service would begin as soon as early next year.\n\nRegardless of what emerges as the cause of the disaster, which the company called a “serious anomaly,” the event is a setback for the budding space-tourism industry. It could even prompt federal efforts to step up oversight of such ventures.\n\n\nvirgin galactic,\nvirgin galactic spaceship 2,\nvirgin galactic crash,\nvirgin galactic space flight,\nvirgin galactic 2014,\nvirgin galactic documentary,\nvirgin galactic commercial,\nvirgin galactic test flight 2014,\nvirgin galactic test flight,\nvirgin galactic landing,\nvirgin galactic spaceship 2,\nvirgin galactic crash,\nvirgin galactic space flight,\nvirgin galactic test flight 2014,\nvirgin galactic test flight,\nvirgin galactic crash,\nvirgin galactic spaceship 2 test flight,\nspaceship 2 virgin galactic,","styleRuns":[{"startIndex":0,"length":1923,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4293783021},{"key":"USER_INTERFACE_THEME_LIGHT","value":4280295456}]}},"fontFamilyName":"Roboto"}]},"enableColorSampledDescriptionBodyText":true}},{"videoDescriptionInfocardsSectionRenderer":{"sectionTitle":{"simpleText":"Hot News Now"},"creatorVideosButton":{"buttonRenderer":{"style":"STYLE_INACTIVE_OUTLINE","size":"SIZE_DEFAULT","isDisabled":false,"text":{"simpleText":"Videos"},"icon":{"iconType":"MY_VIDEOS"},"trackingParams":"CBwQ8FsiEwiNhoLEsaqYAxVR3REIHdcONBY=","command":{"clickTrackingParams":"CBwQ8FsiEwiNhoLEsaqYAxVR