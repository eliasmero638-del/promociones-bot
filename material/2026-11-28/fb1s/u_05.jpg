headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1510,"length":18,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1528,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1548,"length":17,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1565,"length":20,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1585,"length":37,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1622,"length":22,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1644,"length":31,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1675,"length":24,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1699,"length":12,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1711,"length":22,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1733,"length":128,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982975,"raisedBackground":4293982975,"additiveBackground":558210505,"textPrimary":4278855478,"textSecondary":4282015086,"invertedBackground":4279855247,"overlayBackground":3423217462},"darkThemeColorPalette":{"baseBackground":4278326300,"raisedBackground":4278855478,"additiveBackground":725982665,"textPrimary":4292932090,"textSecondary":4289514717,"invertedBackground":4286366435,"overlayBackground":3423217462},"colorSampledDescriptionBodyText":{"content":"Este 12 de diciembre, miles de peregrinos continúan arribando a la Basílica de Guadalupe, en la alcaldía Gustavo A. Madero, para conmemorar 494 años de la aparición de la Virgen de Guadalupe. Con una temperatura aproximada de 11 grados, muchos fieles han optado por recorrer los últimos 300 metros de rodillas o a gatas, en señal de agradecimiento o petición, mientras otros ascienden al cerro del Tepeyac, que se reporta completamente lleno.\n\nLas celebraciones religiosas continúan durante todo el día, destacando la Misa de las Rosas programada a las 12 del día. Autoridades locales mantienen operativos de apoyo y atención, tanto para los peregrinos como para animales en situación de calle en la zona. La circulación vehicular en las inmediaciones de la Basílica se encuentra severamente afectada, por lo que se pide a la población extremar precauciones y respetar el paso de los fieles.\n\nEn este contexto, la presidenta Claudia Sheinbaum informó que sostuvo una conversación telefónica con el Papa León XIV, a quien invitó formalmente a visitar México. En su mensaje, destacó que, más allá de la religión y de la laicidad del Estado, la Virgen de Guadalupe es un símbolo de identidad y paz para las y los mexicanos. Hasta el momento, no se ha confirmado una posible visita papal.\n\nGrupo Fórmula\n\n¡Suscríbete a nuestro canal de YouTube! http://goo.gl/NAKFkj\n\nPodcast: https://open.spotify.com/playlist/50b...\n\nMantente informado minuto a minuto en nuestras redes sociales:\nFacebook-----http://goo.gl/5UHZOQ\nTwitter----------http://goo.gl/nEXxVF\n\nCanal sugerido\nhttp://goo.gl/hst33f\n\nSigue nuestra transmisión en vivo:\nhttps://bit.ly/3rDc3aJ\n\nDescarga nuestra App:\n\niOS:  https://apple.co/3rANPOj\n\nAndroid:  https://bit.ly/3gu8dKF\n\nPara dudas, comentarios o sugerencias ponte en contacto con nosotros a través de la dirección:\ncomentarios@radioformula.com.mx","commandRuns":[{"startIndex":1341,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBsQ040EGAYiEwjn-qrQsKqYAxWIVPYIHUXACBZInIfa4YWEqsGaAcoBBAdmAio=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IYl9sNXkxN2liakV4MzI5bTJRRk5SZHxBQnJ0NjltNzVORTNHSUgwM082bDM4bHZ6RmU5MG1ReGpOeHRYd0NvbVVYOXZqaTlDaWhJYXVIYTFuRVhaQ0ZjeFF2dHNtc0pIMl9uRHh