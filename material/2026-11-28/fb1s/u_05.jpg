gParams":"CC0QiPkBIhMI5_qq0LCqmAMViFT2CB1FwAgW","type":"BUTTON_VIEW_MODEL_TYPE_TEXT","buttonSize":"BUTTON_VIEW_MODEL_SIZE_DEFAULT","loggingDirectives":{"trackingParams":"CC0QiPkBIhMI5_qq0LCqmAMViFT2CB1FwAgW","visibility":{"types":"12"}}}},"rendererContext":{"loggingContext":{"loggingDirectives":{"trackingParams":"CCwQ0f0TGAAiEwjn-qrQsKqYAxWIVPYIHUXACBY=","visibility":{"types":"12"}}}}}},{"videoDescriptionHeaderRenderer":{"channel":{"simpleText":"Grupo Fórmula"},"views":{"simpleText":"8.779 Aufrufe"},"publishDate":{"simpleText":"12.12.2025"},"factoid":[{"factoidRenderer":{"value":{"simpleText":"14"},"label":{"simpleText":"Likes"},"accessibilityText":"14 Likes","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egttb0tvSUZ3Mmc1dyDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"8779"},"label":{"simpleText":"Aufrufe"},"accessibilityText":"8.779 Aufrufe","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED"}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"12. Dez."},"label":{"simpleText":"2025"},"accessibilityText":"12.12.2025","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","position":"FACTOID_POSITION_LAST"}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBsQ040EGAYiEwjn-qrQsKqYAxWIVPYIHUXACBbKAQQHZgIq","commandMetadata":{"webCommandMetadata":{"url":"/@GrupoFormula-RF","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCzmd9Aj2wmPggWZJpLdBB8Q","canonicalBaseUrl":"/@GrupoFormula-RF"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/0PozGtiQHr3tdxV2nRI0lZA-WraO3DsGwudLYAYgaXOj1V72NU8UOkg1lgJWSkIDNDIosNgSapY=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Mehr anzeigen"}},"simpleText":"...mehr"},"showLessText":{"simpleText":"Weniger anzeigen"},"attributedDescriptionBodyText":{"content":"Este 12 de diciembre, miles de peregrinos continúan arribando a la Basílica de Guadalupe, en la alcaldía Gustavo A. Madero, para conmemorar 494 años de la aparición de la Virgen de Guadalupe. Con una temperatura aproximada de 11 grados, muchos fieles han optado por recorrer los últimos 300 metros de rodillas o a gatas, en señal de agradecimiento o petición, mientras otros ascienden al cerro del Tepeyac, que se reporta completamente lleno.\n\nLas celebraciones religiosas continúan durante todo el día, destacando la Misa de las Rosas programada a las 12 del día. Autoridades locales mantienen operativos de apoyo y atención, tanto para los peregrinos como para animales en situación de calle en la zona. La circulación vehicular en las inmediaciones de la Basílica se encuentra severamente afectada, por lo que se pide a la población extremar precauciones y respetar el paso de los fieles.\n\nEn este contexto, la presidenta Claudia Sheinbaum informó que sostuvo una conversación telefónica con el Papa León XIV, a quien invitó formalmente a visitar México. En su mensaje, destacó que, más allá de la religión y de la laicidad del Estado, la Virgen de Guadalupe es un símbolo de identidad y paz para las y los mexicanos. Hasta el momento, no se ha confirmado una posible visita papal.\n\nGrupo Fórmula\n\n¡Suscríbete a nuestro canal de YouTube! http://goo.gl/NAKFkj\n\nPodcast: https://open.spotify.com/playlist/50b...\n\nMantente informado minuto a minuto en nuestras redes sociales:\nFacebook-----http://goo.gl/5UHZOQ\nTwitter----------http://goo.gl/nEXxVF\n\nCanal sugerido\nhttp://goo.gl/hst33f\n\nSigue nuestra transmisión en vivo:\nhttps://bit.ly/3rDc3aJ\n\nDescarga nuestra App:\n\niOS:  https://apple.co/3rANPOj\n\nAndroid:  https://bit.ly/3gu8dKF\n\nPara dudas, comentarios o sugerencias ponte en contacto con nosotros a través de la dirección:\ncomentarios@radioformula.com.mx","commandRuns":[{"startIndex":1341,"length":20,"onTap":{"innertubeComma