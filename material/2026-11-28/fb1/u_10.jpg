"}]},"serviceEndpoint":{"clickTrackingParams":"CM8BEPBbIhMI_O_rprCqmAMVN1lPBB26-hVAKPgdMgV3YXRjaMoBBJ-sTvA=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/unsubscribe"}},"unsubscribeEndpoint":{"channelIds":["UCzmd9Aj2wmPggWZJpLdBB8Q"],"params":"CgIIAxILbW9Lb0lGdzJnNXcYAA%3D%3D"}},"accessibility":{"label":"Abo beenden"},"trackingParams":"CM8BEPBbIhMI_O_rprCqmAMVN1lPBB26-hVA"}},"cancelButton":{"buttonRenderer":{"style":"STYLE_TEXT","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Abbrechen"}]},"accessibility":{"label":"Abbrechen"},"trackingParams":"CM4BEPBbIhMI_O_rprCqmAMVN1lPBB26-hVA"}},"primaryIsCancel":false}},"popupType":"DIALOG"}}]}}]}},"metadataRowContainer":{"metadataRowContainerRenderer":{"collapsedItemCount":0,"trackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVA"}},"showMoreText":{"simpleText":"mehr"},"showLessText":{"simpleText":"Weniger anzeigen"},"trackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVA","defaultExpanded":false,"descriptionCollapsedLines":3,"showMoreCommand":{"clickTrackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVAygEEn6xO8A==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVAygEEn6xO8A==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_EXPANDED"}},{"clickTrackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVAygEEn6xO8A==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVAygEEn6xO8A==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"Este 12 de diciembre, miles de peregrinos continúan arribando a la Basílica de Guadalupe, en la alcaldía Gustavo A. Madero, para conmemorar 494 años de la aparición de la Virgen de Guadalupe. Con una temperatura aproximada de 11 grados, muchos fieles han optado por recorrer los últimos 300 metros de rodillas o a gatas, en señal de agradecimiento o petición, mientras otros ascienden al cerro del Tepeyac, que se reporta completamente lleno.\n\nLas celebraciones religiosas continúan durante todo el día, destacando la Misa de las Rosas programada a las 12 del día. Autoridades locales mantienen operativos de apoyo y atención, tanto para los peregrinos como para animales en situación de calle en la zona. La circulación vehicular en las inmediaciones de la Basílica se encuentra severamente afectada, por lo que se pide a la población extremar precauciones y respetar el paso de los fieles.\n\nEn este contexto, la presidenta Claudia Sheinbaum informó que sostuvo una conversación telefónica con el Papa León XIV, a quien invitó formalmente a visitar México. En su mensaje, destacó que, más allá de la religión y de la laicidad del Estado, la Virgen de Guadalupe es un símbolo de identidad y paz para las y los mexicanos. Hasta el momento, no se ha confirmado una posible visita papal.\n\nGrupo Fórmula\n\n¡Suscríbete a nuestro canal de YouTube! http://goo.gl/NAKFkj\n\nPodcast: https://open.spotify.com/playlist/50b...\n\nMantente informado minuto a minuto en nuestras redes sociales:\nFacebook-----http://goo.gl/5UHZOQ\nTwitter----------http://goo.gl/nEXxVF\n\nCanal sugerido\nhttp://goo.gl/hst33f\n\nSigue nuestra transmisión en vivo:\nhttps://bit.ly/3rDc3aJ\n\nDescarga nuestra App:\n\niOS:  https://apple.co/3rANPOj\n\nAndroid:  https://bit.ly/3gu8dKF\n\nPara dudas, comentarios o sugerencias ponte en contacto con nosotros a través de la dirección:\ncomentarios@radioformula.com.mx","commandRuns":[{"startIndex":1341,"length":20,"onTap":{"innertubeCommand":{"clickTrackingParams":"CMsBEM2rARgBIhMI_O_rprCqmAMVN1lPBB26-hVASJyH2uGFhKrBmgHKAQSfrE7w","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?ev