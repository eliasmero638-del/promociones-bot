 "segmentos": [
  {
   "texto": "Su último mensaje fue una sola palabra: STENDEC.",
   "t0": 0.0,
   "img": "esc_00.jpg",
   "escena": {
    "tipo": "fecha",
    "texto": "2 AGOSTO 1947",
    "sub": "Cordillera de los Andes"
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Mil novecientos cuarenta y siete. El avión Star Dust despega de Buenos Aires rumbo a Santiago de Chile.",
   "t0": 13.151,
   "img": "esc_01.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
     "Avro Lancastrian",
     "Avro Lancastrian BSAA"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Lleva once personas, y tiene que cruzar la cordillera de los Andes.",
   "t0": 23.23,
   "img": null,
   "escena": {
    "tipo": "video",
    "url": "https://www.youtube.com/watch?v=PQEdkbnYcT4",
    "desde": 10,
    "dur": 6,
    "buscar_video": [
     "Andes mountains aerial"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "A las cinco y cuarenta y uno, el radiooperador avisa en código Morse: llegan a Santiago en cuatro minutos.",
   "t0": 27.37,
   "img": "esc_03.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
     "Morse key telegraph",
     "telegraph key"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Y al final, una palabra extraña: STENDEC.",
   "t0": 40.43,
   "img": "esc_04.jpg",
   "escena": {
    "tipo": "fecha",
    "texto": "STENDEC",
    "sub": "5:41 p. m."
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "En el aeropuerto no la entienden. Piden repetirla… y la repite dos veces.",
   "t0": 43.79,
   "img": "esc_05.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
     "Los Cerrillos airport",
     "Aeropuerto Los Cerrillos"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Después, silencio. El avión desaparece.",
   "t0": 52.17,
   "img": "esc_06.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
     "Tupungato",
     "Tupungato volcano"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Durante cincuenta y un años, nadie supo dónde estaba.",
   "t0": 55.37,
   "img": null,
   "escena": {
    "tipo": "contador",
    "n": 51,
    "texto": "AÑOS",
    "sub": "sin rastro del avión"
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "En mil novecientos noventa y ocho, dos andinistas hallan un motor del avión en un glaciar del Tupungato.",
   "t0": 58.07,
   "img": "v_08.mp4",
   "escena": {
    "tipo": "video",
    "url": "https://www.youtube.com/watch?v=QTKfrTrx0pg",
    "desde": 30,
    "dur": 6,
    "buscar_video": [
     "Andes glacier climbers"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "El hielo lo estaba devolviendo de a poco.",
   "t0": 69.01,
   "img": "esc_09.jpg",
   "escena": {
    "tipo": "foto",
    "buscar": [
     "Rolls-Royce Merlin engine",
     "Merlin engine"
    ]
   },
   "short": false,
   "rotulo": ""
  },
  {
   "texto": "Hoy se cree que un viento fortísimo los frenó, y bajaron entre las nubes antes de cruzar la montaña.",
   "t0": 72.79,
   "img": "esc_10.jpg",
   "escena": {
    "tipo": "mapa",
    "lat": -33.37,
    "lon": -69.76,
    "lugar": "Volcán Tupungato",
    "km": 30
   },
   "short": false,
   "rotulo": ""
  },
  {
