anadair CL-44, KC-97, Antonov An-2, An-26, An-124, Ilyushin IL-18, IL-14, Shorts Belfast, B-17G, C-117, and Shorts Sunderland Flying Boats with images taken in the 60s, 70s, 80s and 90s.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcTx6-kYPjyaf9h1zWf0FjKD1g01tl_aAaQL8qzwXe83haiQror8Xmc_NG-9fA","width":128,"height":112},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcSlEXFcdRDgZySw0XE7Wc2mG522JFFDeJ1H83qKyDks5M5UEqa-8swHNU2n0GQ","width":256,"height":223},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcQnxswh0VN3BZ4ojRUS3NM9gJBPxvbIOJ9eycOHhk0luVIq0-Jt_QvizI9t3VQ","width":512,"height":446}],"placeholderColor":4294967295},"price":"","vendorName":"JetFlix","trackingParams":"CIMCEJP0ARgBIhMI6L6zveeYmAMVtERBAh1oYT0F","buttonText":"Shop","buttonCommand":{"clickTrackingParams":"CIMCEJP0ARgBIhMI6L6zveeYmAMVtERBAh1oYT0FygEEyD3xHQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CIMCEJP0ARgBIhMI6L6zveeYmAMVtERBAh1oYT0FygEEyD3xHQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpJKZru4fct75XG2b0qLslI6CcuurhK-vyFhYKRtVZ9yvm0zP2YfnA63K73zesXJeOz63f1tUk-5uktb4vA4b6BX-mktOksSLIJuetnM7COepPtzv5SXQjB7vVgIiINYE9MsyafSMtUv81_iOGcdmod6LlyB_2blcwiDj7dZ5jS8p44Ore0qMNg0Wudb02usXNzvwt8Cp__IrMJUXXAIdOkXYdY0_9nh0ip3_KxSpviNFYZBI9T3TGMmNSiT2FWT7y1-DNN_f_bHaGcj6GCjKsdz99gQwI_OKAC-bMxmm6ChsAtCQST1VrS4e2l3vC1JgzG2WhC7km0uldHwEmxW9f4MTeYrqV_18YYEoG5sYS0nIyM-D-ho2qCX2TOipjNIrd-1ZkT_dowrc_0USvryMPj04W8aqeoXfMDSVd3m-L85faMX-MgODSgA3Cu2YRzHq6-ILBdALgtl9Se9MsooiE_jZxYj_BkHhzfoQSuHbPBdZxblPERcnpv4yQ5kS_daSW1QAyzq-Zm40VYA2PVEQ6jHrjzUQ1OQ3FUZTYPT0w57Fou-yijh9SQ3utRdFQiA6cM9lj1F6rNJo_Ymm8NGiAlIG6wfGw"}},{"clickTrackingParams":"CIMCEJP0ARgBIhMI6L6zveeYmAMVtERBAh1oYT0FygEEyD3xHQ==","commandMetadata":{"webCommandMetadata":{"url":"https://jetflix-hsu-shop.fourthwall.com/products/air-to-air-ultimate-airline-photography?variant=cb8a6