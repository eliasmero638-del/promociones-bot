# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here

# Sales System Configuration
# VIP group numeric ID (e.g., -1001234567890) for dynamic invite link creation
SALES_VIP_GROUP_ID=your_vip_group_id_here

# Trial group numeric ID (e.g., -1001234567890) for auto-kick after 1 minute
SALES_TRIAL_GROUP_ID=your_trial_group_id_here

# Optional: enables the AI free-text fallback (ventas/sales_ai.py). Without
# it, the bot just shows the main menu for any text it doesn't recognize.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
