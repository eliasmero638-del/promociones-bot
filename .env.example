# =============================================================================
# CONFIGURACIÓN DEL BOT (promociones + ventas, es un único bot de Telegram)
# =============================================================================
# Guía completa para levantar una instalación nueva (otro cliente):
# ver NUEVA_INSTALACION.md
#
# Todas las variables listadas abajo son OPCIONALES salvo BOT_TOKEN y
# GROUP_ID: si no las defines, el bot usa los valores que ya tenía antes de
# que este archivo existiera (compatibilidad total con la instalación
# actual). Para una instalación NUEVA, se recomienda definir TODAS.

# --- Núcleo (obligatorias) ---
BOT_TOKEN=your_telegram_bot_token_here
GROUP_ID=your_promotions_group_id_here

# --- Administradores ---
# IDs numéricos de Telegram (no @username) separados por coma. El primero
# es el admin "principal" (usado en botones tg://user?id=...). Todos tienen
# acceso a /panel, /debug_storage y a aprobar/rechazar pagos.
ADMIN_USER_IDS=111111111,222222222

# @username (sin @) usado como contacto por defecto en promociones nuevas
# y en la pantalla "Quiero vender contenido".
DEFAULT_ADMIN_USERNAME=tu_usuario_admin

# @username (sin @) usado como contacto fijo en todo el flujo de ventas
# (botones "Contactar/Hablar con el administrador").
SALES_ADMIN_CONTACT_USERNAME=tu_usuario_admin

# Nombre de marca mostrado en textos de bienvenida.
BRAND_NAME=Mi Marca VIP

# --- Almacenamiento persistente (elige UNA opción, o ninguna para pruebas) ---
# Opción A: Upstash Redis (recomendado en Railway) - crea tu propia base
# gratuita en https://upstash.com, una POR CADA instalación (nunca
# compartas la misma base entre dos bots, se pisarían los datos).
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
# Opción B: Railway Volume (si no usas Upstash) - ruta de montaje del volumen.
DATA_DIR=

# =============================================================================
# SISTEMA DE VENTAS VIEJO (2 grupos: demo + VIP) - ventas/config.py
# =============================================================================
SALES_VIP_PRICE=$8 permanente
SALES_BANK_GUAYAQUIL_DETAILS="Cuenta de ahorros: 0000000000\nTitular: Nombre Apellido"
SALES_BANK_PICHINCHA_DETAILS="Cuenta: 0000000000\nTitular: Nombre Apellido"
SALES_PAYPAL_DETAILS="tucorreo@ejemplo.com\nTitular: Nombre Apellido"
SALES_FAQ_TEXT="❓ PREGUNTAS FRECUENTES\n\n..."

# Grupo de prueba (demo) - expulsión automática a 1 minuto si se configura el ID.
SALES_DEMO_GROUP_LINK=https://t.me/+tu_enlace_de_invitacion
SALES_TRIAL_GROUP_ID=your_trial_group_id_here

# Grupo VIP (creación de enlaces de invitación dinámicos).
SALES_VIP_GROUP_LINK=
SALES_VIP_GROUP_ID=your_vip_group_id_here

# Grupos de venta por nombre (sistema viejo, 2 grupos con precio fijo).
SALES_PORTOVIEJO_GROUP_ID=
SALES_PORTOVIEJO_GROUP_LINK=https://t.me/+tu_enlace_de_invitacion
SALES_ECUATORIANAS_GROUP_ID=
SALES_ECUATORIANAS_GROUP_LINK=https://t.me/+tu_enlace_de_invitacion

# "🆓 Obtener grupo Free" (acceso permanente, independiente del resto).
SALES_FREE_GROUP_LINK=https://t.me/+tu_enlace_de_invitacion

# "🔒 Acceso exclusivo a grupos VIP" -> prueba de 2 minutos, un solo uso.
# El ID se completa solo al agregar el bot como admin a ese grupo.
SALES_VIP_EXCLUSIVE_TRIAL_GROUP_LINK=https://t.me/+tu_enlace_de_invitacion
SALES_VIP_EXCLUSIVE_TRIAL_GROUP_ID=

# =============================================================================
# SISTEMA DE VENTAS NUEVO (5 grupos, selección múltiple) - ventas/multisale_config.py
# =============================================================================
# Precio de oferta según cuántos grupos se seleccionen (1 a 5).
MULTISALE_PRICE_1=6.99
MULTISALE_PRICE_2=9.99
MULTISALE_PRICE_3=12.99
MULTISALE_PRICE_4=16.99
MULTISALE_PRICE_5=19.99

# Los 5 grupos. Cambia label/description/link por los de tu cliente.
# La clave (PORTOVIEJO, MANTA, ...) es fija en el código - solo cambia el
# contenido de cada variable, no el nombre de la variable.
MULTISALE_GROUP_PORTOVIEJO_LABEL=1️⃣ Grupo 1
MULTISALE_GROUP_PORTOVIEJO_DESCRIPTION=Descripción del grupo 1.
MULTISALE_GROUP_PORTOVIEJO_LINK=https://t.me/+tu_enlace_de_invitacion

MULTISALE_GROUP_MANTA_LABEL=2️⃣ Grupo 2
MULTISALE_GROUP_MANTA_DESCRIPTION=Descripción del grupo 2.
MULTISALE_GROUP_MANTA_LINK=https://t.me/+tu_enlace_de_invitacion

MULTISALE_GROUP_ECUATORIANAS_LABEL=3️⃣ Grupo 3
MULTISALE_GROUP_ECUATORIANAS_DESCRIPTION=Descripción del grupo 3.
MULTISALE_GROUP_ECUATORIANAS_LINK=https://t.me/+tu_enlace_de_invitacion

MULTISALE_GROUP_VIPEC_LABEL=4️⃣ Grupo 4
MULTISALE_GROUP_VIPEC_DESCRIPTION=Descripción del grupo 4.
MULTISALE_GROUP_VIPEC_LINK=https://t.me/+tu_enlace_de_invitacion

MULTISALE_GROUP_AZULES_LABEL=5️⃣ Grupo 5
MULTISALE_GROUP_AZULES_DESCRIPTION=Descripción del grupo 5.
MULTISALE_GROUP_AZULES_LINK=https://t.me/+tu_enlace_de_invitacion

# Los 4 métodos de pago. Mismo criterio: la clave es fija, cambia el contenido.
MULTISALE_PAYMENT_INTERBANCARIO_LABEL=🏦 Pago interbancario
MULTISALE_PAYMENT_INTERBANCARIO_DETAILS="Banco: ...\nTipo de cuenta: ...\nNúmero de cuenta: ...\nTitular: ...\nCédula: ..."

MULTISALE_PAYMENT_BANK_PICHINCHA_LABEL=🏦 Banco Pichincha
MULTISALE_PAYMENT_BANK_PICHINCHA_DETAILS="Cuenta: 0000000000\nTitular: Nombre Apellido"

MULTISALE_PAYMENT_BANK_GUAYAQUIL_LABEL=🏦 Banco Guayaquil
MULTISALE_PAYMENT_BANK_GUAYAQUIL_DETAILS="Cuenta: 0000000000\nTitular: Nombre Apellido"

MULTISALE_PAYMENT_PAYPAL_LABEL=💙 PayPal
MULTISALE_PAYMENT_PAYPAL_DETAILS="tucorreo@ejemplo.com\nTitular: Nombre Apellido"

# --- Mensaje de bienvenida al grupo de promociones (opcional) ---
# El texto y la imagen de bienvenida se configuran desde /panel una vez el
# bot está corriendo (Configurar Bienvenida). Esta variable solo define el
# enlace SEED del botón "Únete al Grupo Free" la primera vez que arranca
# (después es editable desde /panel sin volver a tocar esta variable).
WELCOME_FREE_GROUP_URL=https://t.me/+tu_enlace_de_invitacion
